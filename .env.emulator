# Frontend config for LOCAL (emulator) runs — `npm run dev:local`.
#
# COMMITTED ON PURPOSE: nothing here is secret, and there is no real project
# behind it. `demo-*` is a Firebase convention meaning "emulator only", so the
# SDK never contacts a real project even if the emulator is down.
#
# The mode is named `emulator`, not `local`, because Vite rejects `--mode local`
# outright (it collides with the `.local` env-file suffix).

VITE_FIREBASE_PROJECT_ID=demo-tailed1
VITE_FIREBASE_AUTH_DOMAIN=demo-tailed1.firebaseapp.com

# The emulator accepts any non-empty API key.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_STORAGE_BUCKET=demo-tailed1.appspot.com

# Points the Firebase SDK at the emulator suite (auth on :9100, per firebase.json).
# Replaces the old implicit `projectId.startsWith("demo-")` sniff.
VITE_USE_EMULATORS=true

# The Express listener index.ts starts when APP_ENV=local.
VITE_API_URL=http://localhost:3001
VITE_COMPANIES_API_URL=http://localhost:3000
