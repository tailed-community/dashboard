# =============================================================================
# FRONTEND environment template. Copy to `.env.local` and fill in.
# =============================================================================
#
# HOW VITE RESOLVES THESE (later wins):
#   1. .env                     (legacy catch-all; prefer the files below)
#   2. .env.local               gitignored, per-developer overrides
#   3. .env.<mode>              e.g. .env.emulator, .env.production
#   4. .env.<mode>.local        gitignored
#   5. process.env VITE_*       ALWAYS WINS — this is how CI overrides files
#
# Note: `--mode local` is a hard Vite error (it collides with the `.local`
# file suffix). The emulator mode is therefore named `emulator`.
#
# Nothing here is secret. Every VITE_* value is compiled into the client
# bundle and served to every visitor. Firebase "API keys" are project
# identifiers, not credentials — access is enforced by Security Rules.
#
# ENVIRONMENTS
#   local      -> demo-tailed1            (emulator suite only, no cloud project)
#   dev        -> tailed-community-dev    (real project; sends real email)
#   production -> tailed-community-fb11e  (real project)
# =============================================================================

# --- Firebase project ---
# Must match the backend's FB_PROJECT_ID for the same environment: a magic link
# is minted by one project and can only be completed against that same project.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- APIs ---
# Local: http://localhost:3001 (the Express listener that index.ts starts when
# APP_ENV=local). Deployed: the Cloud Functions origin for that project.
VITE_API_URL=http://localhost:3001
VITE_COMPANIES_API_URL=http://localhost:3000

# --- Emulator ---
# "true" points the Firebase SDK at the local emulator suite (auth on :9100).
# This replaced the old implicit `projectId.startsWith("demo-")` sniff, which
# silently used PRODUCTION auth whenever the project id didn't happen to match.
VITE_USE_EMULATORS=false

# --- Analytics (optional) ---
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=
