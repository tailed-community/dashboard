{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "source": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "frameworksBackend": {
      "region": "us-central1"
    },
    "rewrites": [
      {
        "source": "/s/**",
        "function": { "functionId": "app", "region": "us-central1" }
      },
      {
        "source": "/f/**",
        "function": { "functionId": "app", "region": "us-central1" }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9100
    },
    "functions": {
      "port": 5003
    },
    "firestore": {
      "port": 8081
    },
    "hosting": {
      "port": 5004
    },
    "storage": {
      "port": 9200
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
